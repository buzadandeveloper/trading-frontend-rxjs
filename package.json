{
  "name": "trading-frontend-rxjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm:dev:rspack\" \"pnpm:dev:ts\"",
    "dev:rspack": "rspack dev",
    "dev:ts": "tsc -b --watch",
    "build": "pnpm lint && pnpm type:check && pnpm circular:check && rspack build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "tsc -b",
    "circular:check": "madge --circular --extensions ts,tsx src/",
    "lint": "rslint",
    "preview": "rspack preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "clsx": "2.1.1",
    "concurrently": "10.0.4",
    "lefthook": "2.1.10",
    "madge": "8.0.0",
    "observable-hooks": "4.2.4",
    "postcss": "8.5.26",
    "postcss-loader": "8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@rslint/core": "^0.6.5",
    "@rspack/cli": "^2.1.9",
    "@rspack/core": "^2.1.9",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.5",
    "react-refresh": "^0.18.0",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#app": "./src/app/index",
    "#components": "./src/components/index",
    "#constants": "./src/constants/index",
    "#hooks": "./src/hooks/index",
    "#icons": "./src/icons/index",
    "#layouts": "./src/layouts/index",
    "#lib": "./src/lib/index",
    "#utils": "./src/utils/index",
    "#pages": "./src/pages/index",
    "#service/*": "./src/service/*",
    "#service": "./src/service/index",
    "#types": "./src/types/index"
  }
}
